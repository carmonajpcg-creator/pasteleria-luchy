{
  "name": "pasteleria-luchy",
  "version": "0.1.0",
  "description": "Tienda de reposteria con pedido por WhatsApp",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "test:concurrency": "node scripts/test-concurrency.mjs",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "backup": "node scripts/backup-datos.mjs",
    "restaurar": "node scripts/restaurar-datos.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "private": true
}
